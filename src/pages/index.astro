---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('papers'))
  .sort((a, b) => b.data.addedAt.valueOf() - a.data.addedAt.valueOf())
  .slice(0, 2);
const articles = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
---

<BaseLayout>
  <section class="section">
    <div class="section-head">
      <div><div class="eyebrow">论文</div><h2>最近阅读</h2></div>
      <a href="/papers">查看全部论文 →</a>
    </div>
    <div class="paper-grid">{papers.map((paper) => <PaperCard paper={paper} />)}</div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><div class="eyebrow">博客</div><h2>最近文章</h2></div>
      <a href="/blog">查看全部文章 →</a>
    </div>
    <div class="article-list">{articles.map((article) => <ArticleRow article={article} />)}</div>
  </section>
</BaseLayout>
