---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '文章' },
  { href: '/papers', label: '论文' },
  { href: '/about', label: '关于' }
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Shenrui Liu 首页">
    <span class="wordmark-mark">SL</span>
    <span>Shenrui Liu</span>
  </a>
  <nav aria-label="主导航">
    {links.map((link) => (
      <a href={link.href} class:list={{ active: link.href === '/' ? path === '/' : path.startsWith(link.href) }}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <a class="github-link" href="https://github.com/fengzheng-kite" target="_blank" rel="noreferrer" aria-label="GitHub 主页">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.1 1.2a10.8 10.8 0 0 1 5.7 0c2.2-1.5 3.1-1.2 3.1-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.8 5.5-5.5 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.3 11.3 0 0 0 12 .7Z"/></svg>
    </a>
  </div>
</header>
